{
  "name": "import-staging",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "import-staging",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "import-staging"
    },
    {
      "parameters": {
        "operation": "pdf",
        "binaryPropertyName": "file"
      },
      "id": "extract-pdf-text",
      "name": "Extract From File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first().json.body;\nreturn [{\n  json: {\n    tenantId: body.tenantId,\n    importId: body.importId,\n    callbackUrl: body.callbackUrl,\n    internalToken: body.internalToken,\n    rawText: $json.text\n  }\n}];"
      },
      "id": "build-context",
      "name": "Build context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Eres un parser de listas de precios de refacciones para celulares. Recibes texto crudo extraído de un PDF o Excel. Devuelve EXCLUSIVAMENTE un arreglo JSON (sin texto adicional, sin markdown) de objetos {\"brand\": string, \"model\": string, \"price\": number}. Ignora encabezados, pies de página y líneas sin precio."
            },
            {
              "role": "user",
              "content": "={{ $json.rawText }}"
            }
          ]
        },
        "options": {
          "temperature": 0
        }
      },
      "id": "ai-column-mapping",
      "name": "AI: mapear columnas",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [900, 300],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_OPENAI_CREDENTIAL",
          "name": "OpenAi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Build context').first().json;\nlet rows = [];\nlet error;\ntry {\n  const raw = $json.message?.content ?? $json.text ?? $json.data ?? '';\n  rows = JSON.parse(raw);\n  if (!Array.isArray(rows)) throw new Error('La IA no devolvió un arreglo');\n} catch (e) {\n  error = 'No se pudo interpretar la respuesta de la IA: ' + e.message;\n}\nreturn [{\n  json: {\n    tenantId: ctx.tenantId,\n    importId: ctx.importId,\n    callbackUrl: ctx.callbackUrl,\n    internalToken: ctx.internalToken,\n    rows,\n    error\n  }\n}];"
      },
      "id": "parse-ai-response",
      "name": "Parse AI response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.callbackUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Internal-Token", "value": "={{ $json.internalToken }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { tenantId: $json.tenantId, importId: $json.importId, rows: $json.error ? undefined : $json.rows, error: $json.error } }}"
      },
      "id": "callback-to-api",
      "name": "Callback a la API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Extract From File", "type": "main", "index": 0 }]] },
    "Extract From File": { "main": [[{ "node": "Build context", "type": "main", "index": 0 }]] },
    "Build context": { "main": [[{ "node": "AI: mapear columnas", "type": "main", "index": 0 }]] },
    "AI: mapear columnas": { "main": [[{ "node": "Parse AI response", "type": "main", "index": 0 }]] },
    "Parse AI response": { "main": [[{ "node": "Callback a la API", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
