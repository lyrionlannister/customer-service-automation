# Database Configuration (app_db)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=n8n
DB_PASSWORD=n8n_password_dev
DB_NAME=app_db

# Database Configuration (customer_service — n8n chat histories)
CS_DB_HOST=localhost
CS_DB_PORT=5432
CS_DB_USERNAME=n8n
CS_DB_PASSWORD=n8n_password_dev
CS_DB_NAME=customer_service

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Redis Configuration
REDIS_USER=admin
REDIS_PASSWORD=your-redis-password-change-in-production
REDIS_PORT=6379
REDIS_URL=redis://admin:your-redis-password-change-in-production@redis:6379

# Admin seed (solo se usa si no existe ningún usuario)
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Kaltrafix
ADMIN_EMAIL=admin@kaltrafix.mx
ADMIN_PASSWORD=change-this-password

# Server Configuration
PORT=3000
NODE_ENV=development
ENABLE_WHATSAPP_LISTENER=false
WHATSAPP_AUTH_PATH=/app/.wwebjs_auth
AUTOMATION_URL=http://n8n:5678/webhook/customer-service
